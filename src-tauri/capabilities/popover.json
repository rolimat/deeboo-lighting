{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popover",
  "description": "Minimal permissions for the popover window",
  "windows": ["popover"],
  "permissions": [
    "allow-get-status",
    "allow-popover-visible",
    "allow-get-settings",
    "allow-save-settings",
    "allow-ui-command",
    "allow-quit",
    "allow-open-editor",
    "allow-select-set",
    "allow-select-palette",
    "core:window:allow-set-size",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
