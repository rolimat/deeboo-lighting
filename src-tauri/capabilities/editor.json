{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Minimal permissions for the editor window",
  "windows": ["editor"],
  "permissions": [
    "allow-get-status",
    "allow-get-library",
    "allow-save-library",
    "allow-wizard-start",
    "allow-wizard-choose",
    "allow-wizard-retry",
    "allow-wizard-cancel",
    "allow-strip-identify",
    "allow-wizard-save",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
