{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "Minimal permissions for the editor window",
  "windows": ["editor"],
  "permissions": [
    "allow-get-status",
    "allow-get-settings",
    "allow-save-settings",
    "allow-list-midi-sources",
    "allow-list-audio-inputs",
    "allow-get-library",
    "allow-save-library",
    "allow-wizard-start",
    "allow-wizard-choose",
    "allow-wizard-retry",
    "allow-wizard-cancel",
    "allow-strip-identify",
    "allow-identify-segment",
    "allow-wizard-save",
    "allow-set-wired-segments",
    "allow-message-counts",
    "allow-preview-generated",
    "allow-pattern-sequence",
    "allow-detection-watch",
    "allow-set-detection-thresholds",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
